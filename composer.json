{
    "name": "spatie/laravel-ai-tests",
    "description": "Test your Laravel AI agents against real models with pass rates and readable results",
    "keywords": [
        "spatie",
        "laravel",
        "laravel-ai",
        "ai",
        "evals",
        "testing"
    ],
    "homepage": "https://github.com/spatie/laravel-ai-tests",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Vanderbist",
            "email": "alex@spatie.be",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/process": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "laravel/ai": "^1.1",
        "pestphp/pest": "^4.0||^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "symfony/yaml": "^7.3||^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.0||^10.0",
        "pestphp/pest-plugin-arch": "^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Spatie\\LaravelAiTests\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Spatie\\LaravelAiTests\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spatie\\LaravelAiTests\\LaravelAiTestsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
